{"BLOCK0": {"hash": "ce5dedbb6c59054cb16dc2fd567011401b98518e8f506bf0fdf3178aa733f4e8", "html": "<span>SERVICES</span> / SYSTEMS ENGINEERING", "inline": true}, "BLOCK1": {"hash": "f5d88c5bd8d7bfc552987a42b2970324a90cf29a506baf6f3c0c49abc673542b", "html": "Hands-on engineering across the whole path.", "inline": true}, "BLOCK2": {"hash": "8bfd4599f9ce39819580243eddb5f0a80b60cda15f8a6ca15b3ac936f871ac0b", "html": "I work best where a product or failure crosses boundaries — firmware and hardware, endpoint and PBX, application and infrastructure, service state and user-visible behavior.", "inline": true}, "BLOCK3": {"hash": "1a0a6507d5f456439bf8f57ca5069acd9c7c5cfd3b1e5d9df3e30e1b0ed4c3ad", "html": "Connected Device Firmware", "inline": true}, "BLOCK4": {"hash": "feea05f70de0c73b62b30877ffa94525f89d19bcaca449fd5ffbf138d0f64f34", "html": "Firmware for connected products where the device, hardware interfaces, network behavior and lifecycle all have to agree.", "inline": true}, "BLOCK5": {"hash": "95deece039be0390507821219df364cd66dce9bf1f8c5fc5e98535ed92e0c80a", "html": "Voice &amp; Real-Time Communications", "inline": true}, "BLOCK6": {"hash": "46738c27c335ac888165ff8556579b540e5259d9ea7aba62370a6cc40d6fd635", "html": "SIP/RTP systems from endpoint behavior through PBX and media paths, including the failures that only appear during real calls.", "inline": true}, "BLOCK7": {"hash": "599d6f9d93b5d8297a4d5b07c34dbc86b3cdf4b6c8a779736f6ad9724b5988c5", "html": "Infrastructure &amp; Operations", "inline": true}, "BLOCK8": {"hash": "14359307fdd92df8c5bb188c8d7c16c73f4f8f32c19a354926205c8b6e005a75", "html": "Linux and container infrastructure with clear ingress, health, observability, service state and recovery paths.", "inline": true}, "BLOCK9": {"hash": "650f917c1f46f0b0bfde19a56eecf383dc104fbbf159f40f425a5a26027c0e0e", "html": "Cross-Layer Debugging", "inline": true}, "BLOCK10": {"hash": "17232e33af1bcd93a55ed13d95d5c131ac3575b9d43937d646db5b1b397e52de", "html": "For problems that refuse to stay in one box: audio that is really timing, calls that connect without media, or healthy processes behind broken services.", "inline": true}, "BLOCK11": {"hash": "8c067e98b0a53731694a62dc60b22ae3627562818e2452093d83a8c1847bbe61", "html": "Frame the system", "inline": true}, "BLOCK12": {"hash": "1cb94ece7fcb028bd238f2ea556efdf60545b8ef122cb0d6cd31d5fb102ad3cb", "html": "Map boundaries, clocks, dependencies, data paths and the exact failure before changing behavior.", "inline": true}, "BLOCK13": {"hash": "8a0ddfe7a1f84a87e177de17ecf764cae8882b19304be312a3945671ba667c70", "html": "Make it observable", "inline": true}, "BLOCK14": {"hash": "0165f7a3d965cded4f48222570e6421c53d3ffa19096239b1efeaf41861c8582", "html": "Collect the evidence the system already has: logs, packets, timing, state, metrics and hardware behavior.", "inline": true}, "BLOCK15": {"hash": "1c6c33dda085487c65627c0ac9bb5db04001491adbd8fb8a62020d45af51f997", "html": "Isolate one boundary", "inline": true}, "BLOCK16": {"hash": "6ab6871947477eed19af458bd65998cc26f1b943fd98093a62807007d5946d71", "html": "Preserve a known-good control and change one part of the path at a time.", "inline": true}, "BLOCK17": {"hash": "c84426b6ab9e85b950764efd0ee0cf04d8623e93325347b4600f950f88c57084", "html": "Build and retest", "inline": true}, "BLOCK18": {"hash": "a797089a2eb3893d548bb8f39b24784eeb8e60e4c185046c4483dfe095008359", "html": "Turn the hypothesis into the smallest useful change, then repeat the same failure test.", "inline": true}, "BLOCK19": {"hash": "9e4a8b502fe67df14cf5a782ce169984436886ad1bb540bb7d2bac8ebcc2e536", "html": "Leave a trail", "inline": true}, "BLOCK20": {"hash": "54bad53e61769be03421f210058065281414e5ba649e3d0021b4eaa86d7d821d", "html": "Document architecture, verification and recovery so the system is easier to operate after the fix.", "inline": true}, "BLOCK21": {"hash": "10a5c55b4d72d313d957f2bc2334b3dc7707e8364852824b1df08c1d4857a025", "html": "GOOD FIT", "inline": true}, "BLOCK22": {"hash": "abded918064965fcc81ed4fbf187771f85e21b385a74ac133187fe5572130838", "html": "You already have a real system, a real product, or a real failure.", "inline": true}, "BLOCK23": {"hash": "a56b1349b28f79df11deccb38f7c2b3476451b65e9c3eb34e8a654554698c7cd", "html": "Connected device firmware that has to integrate with the rest of the product.", "inline": true}, "BLOCK24": {"hash": "a72ae66ce3a94a7c899d2d79d281cb2041d836f9730ce220cf1e9d8e0e5c25f6", "html": "Voice or SIP/RTP behavior that needs endpoint-to-media-path debugging.", "inline": true}, "BLOCK25": {"hash": "e35e7749ea193a823b19221842d14d2a82af87ea4563e7f8eb2c90b9984979ae", "html": "Linux/container infrastructure that needs clearer state, health and operational control.", "inline": true}, "BLOCK26": {"hash": "7e1d03fef295a4db1ecb86beffed7082afb069c706971acbdfeca150f871d4f0", "html": "A problem that keeps bouncing between teams because no single layer explains it.", "inline": true}, "BLOCK27": {"hash": "c6392df06422d6dd2fc5622c7034d318714146be2819014c61c885fff08e3f71", "html": "Embedded firmware / real-time audio / SIP-RTP", "inline": true}, "BLOCK28": {"hash": "60f001188de53f7fb9cda09f34235a99aba8b0fd7defe5355aaed38af1ac20fe", "html": "ESP32-S3 Connected Voice Device", "inline": true}, "BLOCK29": {"hash": "5ea4fa34fd702981a8198467b0487c45a4f2eed389b51b3bf6641d8723006535", "html": "Building and debugging a real-time voice device across firmware, codecs, audio timing, packet transport, PBX integration and hardware behavior.", "inline": true}, "BLOCK30": {"hash": "e1d500dbd3d4cf31541ab88ba638295198af1bf0a59c3580792a797ec6ef039a", "html": "Linux / Docker / secure ingress / operations", "inline": true}, "BLOCK31": {"hash": "59f37c3961ce708e0247f8c48e8e91f36bbf51851f5c2dddfbf3d145da7be874", "html": "Infrastructure Operations Platform", "inline": true}, "BLOCK32": {"hash": "5c32d6195d5f583c0f1beacd247abfd1f21e8d9b8a886ea7f76b7fd5bbf58091", "html": "An operations layer for a multi-service Linux environment where runtime state, health, dependencies, access and recovery need to be understood together.", "inline": true}, "BLOCK33": {"hash": "f26a1881461897e2cac64f42a8f61debee1a144ea06606cdbbecb20b6ff8aaa5", "html": "Prometheus / Grafana / failure simulation", "inline": true}, "BLOCK34": {"hash": "e086f3ab8d37a3a5abde3a88040c61bc90bae122f5ace1a84cabfdbd17dc6399", "html": "Production Observability &amp; Alert Validation", "inline": true}, "BLOCK35": {"hash": "2e2872b18d2735addbdc73d48b10ce710f08a54c74e198aeef6d3498f9a82a7f", "html": "Testing whether monitoring detects real failure, including deliberately creating load and proving the complete alert path rather than trusting dashboards.", "inline": true}, "BLOCK36": {"hash": "2cafcd958a56854fab5bc6f56ba0b3405dbe5a8ee252cd3184d5f5417cd57b58", "html": "SIP signaling / RTP media / distributed debugging", "inline": true}, "BLOCK37": {"hash": "551dc74a57183726ebc306412094c66662b9f63f17d775558d7b8110c862ab51", "html": "VoIP &amp; Real-Time Communications Infrastructure", "inline": true}, "BLOCK38": {"hash": "254b2d1a23d37c46d14a9da34e4af68b95ef48e747731f5b13e3b03e87a0c260", "html": "Building and debugging signaling, routing, media, endpoints and infrastructure around real-time communications rather than treating the PBX as the whole system.", "inline": true}, "BLOCK39": {"hash": "d1aa14bfaedbcf4e5b722adb5c104fadea5afa95a1d0dcf779a9c931388da159", "html": "ESP32-S3 / ESP-IDF", "inline": true}, "BLOCK40": {"hash": "372c112919533faf65765f8b947036cd1ebfa5cac827dd6fec006a175741228a", "html": "Audio &amp; codec integration", "inline": true}, "BLOCK41": {"hash": "c2b1b8e2e03928e24b07be3e3cbc597577096c8303d9aa621a147ca2456bdad7", "html": "Provisioning", "inline": true}, "BLOCK42": {"hash": "3626a3c359ed619e379f1d405fa08598ebd8d0afdb5e743559f060112c4037d4", "html": "OTA", "inline": true}, "BLOCK43": {"hash": "16a7d896f1beff126844eb1e43afd501afa88895af9e122eb5cc7e32d9f5d186", "html": "Hardware bring-up", "inline": true}, "BLOCK44": {"hash": "