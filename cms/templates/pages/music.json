{"BLOCK0": {"hash": "79d65c01ab8817977edd4c917fe86db0b2f10178d48e7fc0e9faecee7e094399", "html": "MUSIC · LISTENING NOTES", "inline": true}, "BLOCK1": {"hash": "85578f49f9ec429aeb5d13402677653c2c5b234d4f7c28c84f6ed58eec1be265", "html": "Songs I keep coming back to.", "inline": true}, "BLOCK2": {"hash": "b350c61a0268d17d546ccf17cf9ac91f1da21c464d8703b5c4497320bc774267", "html": "A personal archive of songs, albums and performances I love—and the small things in them that make me return.", "inline": true}, "BLOCK3": {"hash": "6cd4c2561791ea7d85c87c2d4383f7796319c7212345e7007d4d9a765032271e", "html": "No ratings, no “best of” lists, and no attempt to review everything. Just music I care about, written down while it still means something to me.", "inline": true}, "BLOCK4": {"hash": "c1f21dee7e5fcc79b4336674c27384f9bbcd3beed4a2da2be29c36be18633dac", "html": "THE ARCHIVE", "inline": true}, "BLOCK5": {"hash": "df3737096e584c1640726b764f42d341e8631c58658ef1013b6aa41003cdfe8a", "html": "Song notes", "inline": true}, "BLOCK6": {"hash": "e2dafcfcc6eab7503644ba93de937ab8b17203680afa93435c675d7153ee624e", "html": "Most entries begin with one simple question: why did this song stay with me?", "inline": true}, "BLOCK7": {"hash": "da6ed24cd189a9d2546420b305bed40e420254ffe643a69fef5c9bf8f83fba52", "html": "Sometimes the answer is a lyric, a voice, a guitar part, a strange production choice, a memory, or just a few seconds I want to hear again. That is enough reason to write about it.", "inline": true}, "BLOCK8": {"hash": "7caf95ab432ab77d6d719320eb4cb0f0047d58c06c6883b81b696aaa86c0469e", "html": "<strong>Editorial separation.</strong> These batch notes use verified catalog context and editorial interpretation. They do not claim personal listening memories unless a separate personal note exists.", "inline": true}, "BLOCK9": {"hash": "02fc7b2dcc65e63493f8156905e21357035938619cd9743bb9be97b827a51115", "html": "A SMALL NOTE ON SOUND", "inline": true}, "BLOCK10": {"hash": "c0e02eb5f975a3e37f4fa37b25475f6ba833659d55fbfa5966f7f81767072813", "html": "Music first. Engineering when it belongs.", "inline": true}, "BLOCK11": {"hash": "95596cd0fa487a8c9773c1c2a7d0aef665745ff9fdc69e660643489aa7b093aa", "html": "Sometimes a recording, mix, microphone, codec, speaker or playback detail is part of why a song sounds the way it does. When that matters, I’ll follow it briefly. The song stays at the center.", "inline": true}, "BLOCK12": {"hash": "8e2706206914710cefd70ba731add16da29bdd6528bd7112bd029f8d0cc8d179", "html": "LISTENING SIGNAL", "inline": true}, "BLOCK13": {"hash": "1ebe0098a6d4fc208997518cba068037fccdc818dc6cbb4e0815ce60f35e32a0", "html": "01 / MUSIC", "inline": true}, "BLOCK14": {"hash": "7ab952c8bc2be42fe0f700629dd369c53913ca3582719b8e2c5b1d81beef40e4", "html": "SONGS", "inline": true}, "BLOCK15": {"hash": "6d51283fe2cba075f3cde46f694d2aaa04e68f0c0beb140c1fa4db2a250947dd", "html": "ALBUMS", "inline": true}, "BLOCK16": {"hash": "cdff17cc67c70ccc06588da0d31b5fdd50d9fddf0f36ed4737813a4f3fd25a3d", "html": "PERFORMANCES", "inline": true}, "BLOCK17": {"hash": "7bfab6c61f7782c3e365e62af6893210c76baaae9c8f15320512d797bb6fa66e", "html": "NOTES", "inline": true}, "BLOCK18": {"hash": "7bfab6c61f7782c3e365e62af6893210c76baaae9c8f15320512d797bb6fa66e", "html": "NOTES", "inline": true}, "BLOCK19": {"hash": "437af4f6c7a61dfb9dfa6f7bd3cb52efab34e70f36ad645f35d0b98ca685bddf", "html": "GROWING ARCHIVE", "inline": true}, "BLOCK20": {"hash": "e7e741cdae6062beca1ffb5d21ab1d445890c71e213456c7e0b22cb8df0afd7d", "html": "RESEARCH LISTENING ARCHIVE", "inline": true}, "BLOCK21": {"hash": "31c81af38c2ba52d29b1be2b500303c182b7f5d46535892516e7f7d6ce751805", "html": "200 NEW NOTES", "inline": true}, "BLOCK22": {"hash": "82cedb1154a1ee7a7b5ed5981f2205723406eb7f9b0fcf6bea9734f8a9624819", "html": "PF", "inline": true}, "BLOCK23": {"hash": "ca329a55cfcabbb9141e76f038fbf89c340f01819e192f780ffeeae7f091a10d", "html": "Pink Floyd — 100 research listening notes", "inline": true}, "BLOCK24": {"hash": "8289ea2c1601a4f8afe048ad21364b5f5d5172b73e26b19006e7fa333fc71fdf", "html": "OFFICIAL CATALOG →", "inline": true}, "BLOCK25": {"hash": "db052c8066385d54dc1aa02c83ea6cf658a465b5e2f63bfffc5c79ac1dbe8447", "html": "SO", "inline": true}, "BLOCK26": {"hash": "1c474ec4ea4f00ff6b5610ae72a2dd16a678f6def9ae44104bef051dc864270a", "html": "System of a Down — 100 research listening notes", "inline": true}, "BLOCK27": {"hash": "8289ea2c1601a4f8afe048ad21364b5f5d5172b73e26b19006e7fa333fc71fdf", "html": "OFFICIAL CATALOG →", "inline": true}, "BLOCK28": {"hash": "68282fdf06799dc5d163332763346978bec7aec19ec79ab3b33b80e8934f8464", "html": "ALBUM NOTES", "inline": true}, "BLOCK29": {"hash": "c35ae8956643be385822bb4f3a6633864bd73d6b907be11189e8e015057a2c15", "html": "LONGER LISTENING", "inline": true}}